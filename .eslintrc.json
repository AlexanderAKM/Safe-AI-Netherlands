{
  "extends": "next/core-web-vitals",
  "plugins": [
    "i18next"
  ],
  "overrides": [
    {
      "files": [
        "src/app/**/*.tsx",
        "src/components/**/*.tsx"
      ],
      "excludedFiles": [
        "**/research/handbook/page.tsx",
        "src/components/handbook/prose.tsx"
      ],
      "rules": {
        "i18next/no-literal-string": [
          "error",
          {
            "mode": "jsx-only",
            "message": "Text the reader sees belongs in messages/en/<namespace>.json (README: Languages). Hard-coded string",
            "jsx-attributes": {
              "exclude": [
                "className",
                "style",
                "type",
                "key",
                "id",
                "width",
                "height",
                "href",
                "src",
                "srcSet",
                "sizes",
                "target",
                "rel",
                "hrefLang",
                "lang",
                "as",
                "role",
                "loading",
                "decoding",
                "fetchPriority",
                "dateTime",
                "aria-hidden",
                "aria-current",
                "aria-controls",
                "aria-labelledby",
                "aria-describedby",
                "aria-live",
                "aria-haspopup",
                "aria-orientation",
                "weight",
                "size",
                "mirrored",
                "color",
                "prefetch",
                "scroll",
                "replace",
                "locale",
                "namespaces",
                "city",
                "chapter",
                "slug",
                "anchor",
                "kind",
                "variant",
                "tone",
                "align",
                "side",
                "position",
                "layout",
                "level",
                "icon",
                "mode",
                "theme",
                "tag",
                "delay",
                "duration",
                "hero",
                "from",
                "to",
                "accent",
                "background",
                "ground",
                "imageClassName",
                "objectPosition",
                "allow",
                "sandbox",
                "referrerPolicy",
                "inputMode",
                "autoComplete",
                "name",
                "method",
                "action",
                "htmlFor",
                "pdf",
                "file",
                "fileName",
                "data-.*",
                "aria-modal",
                "aria-expanded",
                "aria-selected",
                "aria-pressed",
                "aria-checked",
                "aria-disabled",
                "aria-busy",
                "aria-atomic",
                "aria-relevant",
                "aria-sort",
                "aria-level",
                "tabIndex",
                "inert",
                "draggable",
                "spellCheck",
                "translate",
                "dir",
                "initial",
                "animate",
                "exit",
                "whileInView",
                "viewport",
                "transition",
                "layoutId",
                "strategy",
                "fill",
                "stroke",
                "viewBox",
                "d",
                "xmlns",
                "preserveAspectRatio",
                "fillRule",
                "clipRule",
                "strokeLinecap",
                "strokeLinejoin",
                "strokeWidth",
                "transform",
                "points",
                "cx",
                "cy",
                "r",
                "x",
                "y",
                "x1",
                "x2",
                "y1",
                "y2",
                "rx",
                "ry",
                "offset",
                "stopColor",
                "gradientUnits",
                "fontFamily",
                "textAnchor",
                "dominantBaseline",
                "enableBackground",
                "focusable",
                "open",
                "colSpan",
                "rowSpan",
                "scope",
                "headers",
                "list",
                "pattern",
                "min",
                "max",
                "step",
                "form",
                "accept",
                "capture",
                "media",
                "crossOrigin",
                "integrity",
                "nonce",
                "charSet",
                "content",
                "property",
                "httpEquiv",
                "params",
                "searchParams",
                "component",
                "element",
                "variants"
              ]
            },
            "words": {
              "exclude": [
                "[0-9!-/:-@[-`{-~\\s\u00b7\u2013\u2014\u2019\u2018\u201c\u201d\u2026\u00a9\u2192\u2190\u2191\u2193\u00d7]+",
                "[A-Z_-]+",
                "\\S+@\\S+\\.\\w+",
                "SAIN",
                "(?:SAIN (Amsterdam|Utrecht|Groningen|Eindhoven|Delft|The Hague|Den Haag))",
                "(Stichting )?Safe AI Netherlands",
                "(?:Utrecht|Groningen|Amsterdam|Eindhoven|Delft)",
                "Utrecht \u00b7 Groningen \u00b7 Amsterdam",
                "(?:LinkedIn|Instagram|Substack|Discord|Luma|GitHub|Airtable|Fillout|BlueDot|BlueDot Impact|ARENA)",
                "(?:\\s*(?:[!-]?[a-z0-9]*[-:/\\[][a-z0-9\\-:/\\[\\]\\.#%_(),'=&>*~+!]*|(?:flex|hidden|block|inline|grid|table|relative|absolute|fixed|sticky|underline|italic|uppercase|lowercase|capitalize|truncate|contents|isolate|static|invisible|visible|grow|shrink|border|rounded|shadow|outline|ring|transition|transform|antialiased|kicker|shell|group|peer|container|prose|pub-chip|scroll-smooth|sr-only))(?:\\s+(?:[!-]?[a-z0-9]*[-:/\\[][a-z0-9\\-:/\\[\\]\\.#%_(),'=&>*~+!]*|(?:flex|hidden|block|inline|grid|table|relative|absolute|fixed|sticky|underline|italic|uppercase|lowercase|capitalize|truncate|contents|isolate|static|invisible|visible|grow|shrink|border|rounded|shadow|outline|ring|transition|transform|antialiased|kicker|shell|group|peer|container|prose|pub-chip|scroll-smooth|sr-only)))*\\s*)",
                "(?:a|div|span|li|ul|ol|p|section|article|aside|nav|button|h[1-6]|figure|figcaption|blockquote|dl|dt|dd|table|tr|td|th|em|strong)"
              ]
            },
            "callees": {
              "exclude": [
                "t",
                "t[A-Z]\\w*",
                "\\w+\\.rich",
                "\\w+\\.raw",
                "\\w+\\.markup",
                "\\w+\\.has",
                "useTranslations",
                "getTranslations",
                "formatDate",
                "formatList",
                "formatCityList",
                "localizePath",
                "getPathname",
                "applicationText",
                "require",
                "addEventListener",
                "removeEventListener",
                "querySelector",
                "querySelectorAll",
                "getElementById",
                "matchMedia",
                "includes",
                "indexOf",
                "startsWith",
                "endsWith",
                "replace",
                "split",
                "join",
                "padStart",
                "toLocaleDateString",
                "Intl\\.\\w+",
                "new URL",
                "URLSearchParams",
                "setAttribute",
                "getAttribute",
                "closest",
                "scrollIntoView",
                "push",
                "console\\.\\w+",
                "Error",
                "Date"
              ]
            },
            "object-properties": {
              "exclude": [
                "[A-Z_-]+",
                "locale",
                "target",
                "rel",
                "href",
                "src",
                "as",
                "id",
                "key",
                "type",
                "kind",
                "variant",
                "className",
                "style",
                "namespace",
                "slug",
                "anchor",
                "behavior",
                "block",
                "inline",
                "weight",
                "display",
                "position"
              ]
            }
          }
        ]
      }
    }
  ]
}
